{
  "strategies": [
    {
      "name": "golden_cross",
      "enabled": true,
      "description": "A golden cross occurs when a short-term moving average (SMA) crosses above a long-term moving average, indicating a potential bullish trend.",
      "indicators": ["SMA", "EMA"],
      "verify_freshness": true,
      "conditions": [
        {
          "type": "comparison",
          "left": {
            "indicator": "SMA",
            "window": 60
          },
          "operator": ">",
          "right": {
            "indicator": "EMA",
            "window": 300
          }
        }
      ],
      "signal_type": "LONG_TERM_BUY",
      "signal_window": 6000
    },
    {
      "name": "death_cross",
      "enabled": true,
      "description": "A death cross occurs when a short-term moving average crosses below a long-term moving average, indicating a potential bearish trend.",
      "indicators": ["SMA", "EMA"],
      "verify_freshness": true,
      "conditions": [
        {
          "type": "comparison",
          "left": {
            "indicator": "SMA",
            "window": 60
          },
          "operator": "<",
          "right": {
            "indicator": "EMA",
            "window": 300
          }
        }
      ],
      "signal_type": "LONG_TERM_SELL",
      "signal_window": 6000
    },
    {
      "name": "ema_trend_follow",
